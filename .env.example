# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get these after creating a Stripe account (https://dashboard.stripe.com)
# and a recurring Price for your subscription product.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From the Stripe CLI or your webhook endpoint settings
STRIPE_WEBHOOK_SECRET=

PORT=3000

# Any random string. Lets you check GET /api/admin/stats?key=... for
# visitor/generation/paid-user counts without shell access.
ADMIN_KEY=
