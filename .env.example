# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get these after creating a Lemon Squeezy store (https://app.lemonsqueezy.com)
# and a subscription product. LEMONSQUEEZY_CHECKOUT_URL is the product's
# "Share" > "Checkout link". LEMONSQUEEZY_WEBHOOK_SECRET is the signing
# secret you set when creating the webhook under Settings > Webhooks.
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=

PORT=3000

# Any random string. Lets you check GET /api/admin/stats?key=... for
# visitor/generation/paid-user counts without shell access.
ADMIN_KEY=
